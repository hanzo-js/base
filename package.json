{
  "name": "@hanzo/base",
  "version": "0.2.4",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "description": "Hanzo Base SDK - Reactive queries, CRDT, realtime, and Base-compatible client",
  "type": "module",
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./compat": {
      "import": "./dist/compat/index.js",
      "types": "./dist/compat/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./crdt": {
      "import": "./dist/crdt/index.js",
      "types": "./dist/crdt/index.d.ts"
    },
    "./rest": {
      "import": "./dist/rest/index.js",
      "types": "./dist/rest/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/smoke.mjs && node test/prefix.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/hanzo-js/base",
  "bugs": "https://github.com/hanzo-js/base/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzo-js/base.git"
  },
  "keywords": [
    "hanzo",
    "base",
    "sdk",
    "backend",
    "realtime",
    "reactive",
    "crdt",
    "hanzo-base"
  ]
}
