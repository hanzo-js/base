{
  "name": "@hanzo/base",
  "version": "0.2.9",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "description": "Hanzo Base SDK - Reactive queries, CRDT, realtime, and Base-compatible client",
  "type": "module",
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./compat": {
      "import": "./dist/compat/index.js",
      "types": "./dist/compat/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./crdt": {
      "import": "./dist/crdt/index.js",
      "types": "./dist/crdt/index.d.ts"
    },
    "./rest": {
      "import": "./dist/rest/index.js",
      "types": "./dist/rest/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/smoke.mjs && node test/prefix.mjs && node --test test/rest.test.js test/realtime.test.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "19.2.18",
    "react": "19.2.8",
    "tsup": "^8.5.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": ">=19.2.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/hanzo-js/base",
  "bugs": "https://github.com/hanzo-js/base/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzo-js/base.git"
  },
  "keywords": [
    "hanzo",
    "base",
    "sdk",
    "backend",
    "realtime",
    "reactive",
    "crdt",
    "hanzo-base"
  ]
}
